# TCP host:port моделей; до аренды безопасные заглушки.
LLM_PRIMARY=127.0.0.1:9
LLM_BACKUP=127.0.0.1:9
# clore.py генерирует один секрет для обеих моделей и backend. Не публиковать.
# Пустое значение допустимо до аренды; HAProxy стартует и без переменной.
LLM_API_KEY=
# Ключ из clore.ai/profile; хранить только в deploy/.env (не в git).
CLORE_API_KEY=
# USD-Blockchain | CLORE-Blockchain | bitcoin. Цены marketplace — за ДЕНЬ.
CLORE_CURRENCY=USD-Blockchain
# Интерфейс: 0.0.0.0 — доступен из сети, 127.0.0.1 — только с этой машины.
WEB_BIND=0.0.0.0
WEB_PORT=18080
