# OpenAI-совместимый endpoint: llama-server, vLLM за HAProxy, облачный API — код не меняется.
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=local
# Ключ: либо значением, либо именем переменной окружения, где он лежит.
LLM_API_KEY=none
# LLM_API_KEY_ENV=ARCMUX_API_KEY
# json_schema | json_object | off
LLM_JSON_MODE=json_schema
# Для Qwen на vLLM выключаем thinking на шагах с JSON:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY={}
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=300
LLM_MAX_TOKENS=8192
# Сколько историй разбивать на задачи параллельно (llama-server — 1, vLLM — 4).
LLM_CONCURRENCY=1
CONTEXT_CHAR_BUDGET=24000
# Кругов критика: 0–2. Каждый круг — вызов критика и доработка задач по замечаниям.
CRITIC_ROUNDS=2
# Проверка: review — рецензенты историй, редактор стыков, упрощатель, скептик; critic — один критик.
REVIEW_MODE=review
REVIEW_SKEPTIC=true
REVIEW_SIMPLIFIER=true
LANGSMITH_TRACING=false
